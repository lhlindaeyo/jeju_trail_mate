# SITE_ADDRESS 를 도메인(예: trail.example.com)으로 두면 Caddy가 HTTPS 인증서를 자동으로 받습니다.
# 비워 두면 :80(HTTP)만 열립니다 — 터널(cloudflared)이나 앞단 프록시 뒤에서 쓸 때.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# API는 같은 도메인 아래 /v1 로 부르므로(프런트가 상대경로 사용) 여기서 backend 로 넘깁니다.
	handle /v1/* {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# 해시가 붙은 정적 파일은 오래 캐시, 앱 껍데기·서비스워커는 항상 새로 확인(배포하면 바로 반영되게).
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@shell path / /index.html /sw.js /manifest.webmanifest
	header @shell Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
