# 서버의 backend/.env 로 복사해서 쓰는 운영용 예시입니다(`cp deploy/backend.env.example backend/.env`).
# 실제 값이 들어간 .env 는 git에 올라가지 않습니다. APP_ENV·DATABASE_URL·PER_DEVICE_USERS 는
# docker-compose.prod.yml 이 정하므로 여기에 적지 않아도 됩니다.

# 관리자 API(/v1/admin/*) 토큰 — 긴 임의 문자열. 예: openssl rand -hex 32
ADMIN_TOKEN=

# AI 동행자: 앞에서부터 시도하고 한도·장애면 다음으로. 키가 없는 항목은 건너뜁니다. 마지막 mock 은 오프라인 답변.
# 사용자가 AI에 보낸 질문은 이 제공사들의 서버로 나갑니다(앱의 AI 처리 동의 화면이 이 경우에 해당).
LLM_CHAIN=gemini,openrouter,mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_TIMEOUT_S=120
LLM_MAX_TURNS=4

# 날씨(기상청). 둘 다 비면 "예보 확인 필요"로 나오고 비 알림이 꺼집니다.
KMA_APIHUB_KEY=
KMA_SERVICE_KEY=

# 앱을 닫았을 때의 폰 알림(Web Push). 키 만들기: python -m app.push keygen — 없으면 앱이 열려 있을 때만 알림.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:내이메일@example.com
