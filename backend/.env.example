# Copy to backend/.env and fill in. Every external key is optional — features degrade
# gracefully (and say so) when a key is missing.

APP_ENV=development
# DATABASE_URL=sqlite:///./jeju_trail_mate.db  (default: backend/jeju_trail_mate.db)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/jeju_trail_mate
CORS_ORIGINS=http://localhost:5173

# Dev token signing secret — change it (32+ random bytes). Production uses Supabase Auth:
JWT_SECRET=change-me-dev-secret-at-least-32-bytes-long
# SUPABASE_JWT_SECRET=

# Required for /v1/admin/* (course verification, notices). Use a long random value.
ADMIN_TOKEN=

# --- AI companion & journal drafts ---------------------------------------------------------------
# LLM_CHAIN = providers tried in order; the next one is used on rate limit / outage. Providers without a
# key/URL are skipped, so you can list them all. Names: ollama | gemini | groq | openrouter | openai | anthropic | mock
# Nothing configured → offline "mock" mode (keyword → verified tool output only).
# Competition center PC (GTX 1060 6GB): LLM_CHAIN=ollama,mock   (docker-compose.yml does this)
LLM_CHAIN=
# Legacy single-provider switch, used only when LLM_CHAIN is empty: auto | anthropic | mock
LLM_PROVIDER=auto
LLM_TIMEOUT_S=120
LLM_MAX_TURNS=4

# Local model (https://ollama.com). `ollama pull qwen3:4b` — 8b may not fit in 6GB VRAM (it spills to CPU).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# Free-tier cloud APIs (OpenAI-compatible). Several keys may be comma-separated: they rotate on 401/403/429.
# Model names and free limits change — check the provider's docs. User data leaves the server → consent applies.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-14b:free
# Any other OpenAI-compatible server (vLLM, llama.cpp, LM Studio, ...)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# 공공데이터포털 — 기상청 단기예보 조회서비스 (VilageFcstInfoService_2.0) 일반 인증키(Decoding)
KMA_SERVICE_KEY=
# 제주데이터허브 프로젝트키 — 공공와이파이 AP OpenAPI(좌표 포함). 허브 로그인 → 데이터를 프로젝트에 담기 →
# 마이페이지 > 프로젝트 관리의 프로젝트키. 적재: python -m app.data_import wifi-api
JEJU_DATAHUB_APPKEY=

# --- 주소 → 좌표 (가져오기 단계에서만 사용, 앱 실행 중에는 외부 호출 없음) -------------------------------
# GEOCODER_CHAIN 순서대로 시도. 설정 안 된 항목은 건너뜀.
#  local  = 도로명주소 위치정보 요약DB(행안부, 공공누리 1유형·출처표시). data/raw/juso_entrc/ 에 제주 파일을 넣으면 됨. 키 불필요, 오프라인, 저장 가능.
#  vworld = 브이월드 Geocoder/Search 2.0 — 약관상 결과를 DB에 저장할 수 없어 "제안"으로만 보고서에 나옴
#  kakao  = 카카오 Local — KAKAO_STORABLE=true 는 약관에서 저장 허용을 확인한 뒤에만
#  stores = 좌표가 들어 있는 업소 목록과 상호·주소로 맞춤: 소상공인 상가정보(`python -m app.data_import sbiz-fetch`) 또는
#           인허가 음식점 CSV를 data/raw/stores/ 에 넣기. 키 없이 CSV만으로도 가능, 오프라인, 저장 가능
GEOCODER_CHAIN=local,stores,vworld,kakao
# JUSO_ENTRC_DIR=../data/raw/juso_entrc
# STORES_DIR=../data/raw/stores
# 공공데이터포털 일반 인증키(Decoding). 상가정보 API 활용신청 후. 비워 두면 KMA_SERVICE_KEY를 사용
SBIZ_SERVICE_KEY=
VWORLD_API_KEY=
VWORLD_DOMAIN=
KAKAO_REST_API_KEY=
KAKAO_STORABLE=false

# STORAGE_DIR=./storage  (default: backend/storage)
