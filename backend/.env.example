# Copy to backend/.env and fill in. Every key is optional — features degrade gracefully (and say so).
# Other options (Gemini/Groq/OpenRouter/Anthropic LLMs, VWorld/Kakao geocoding, DATABASE_URL, STORAGE_DIR ...)
# are listed in app/config.py.

APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Dev token signing secret and admin token: use long random values (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
ADMIN_TOKEN=

# AI: tried in order, the next one is used when one is unavailable. Without Ollama it falls back to mock.
# Competition center PC: LLM_CHAIN=ollama,mock (docker-compose.yml sets this itself).
LLM_CHAIN=ollama,mock
OLLAMA_MODEL=qwen3:4b

# 공공데이터포털 일반 인증키(Decoding): 기상청 단기예보 / 소상공인 상가(상권)정보 (sbiz-fetch)
KMA_SERVICE_KEY=
SBIZ_SERVICE_KEY=
# 제주데이터허브 프로젝트키 (공공와이파이 AP OpenAPI): 마이페이지 > 프로젝트 관리
JEJU_DATAHUB_APPKEY=

# 주소 → 좌표 (가져오기 단계에서만 사용): local=data/raw/juso_entrc(위치정보 요약DB), stores=data/raw/stores(상가정보·인허가)
GEOCODER_CHAIN=local,stores
